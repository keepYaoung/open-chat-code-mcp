# Listener
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ENDPOINT=/mcp

# Public URL for ChatGPT and Cloudflare Tunnel
MCP_PUBLIC_URL=https://mcp.example.com
MCP_ALLOWED_HOSTS=mcp.example.com,127.0.0.1,localhost
MCP_TRUST_PROXY_HOPS=1

# Authentication
MCP_AUTH_TOKEN=
MCP_ALLOW_NO_AUTH=false
MCP_OAUTH_ENABLED=true
MCP_OAUTH_APPROVAL_KEY=replace-with-a-long-random-key
MCP_OAUTH_ISSUER=https://mcp.example.com
MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
MCP_OAUTH_STATE_FILE=/Users/REPLACE_WITH_YOUR_USERNAME/Library/Application Support/cokacremote/app/state/oauth-state.json

# Project restriction
MCP_DEFAULT_CWD=/Users/REPLACE_WITH_YOUR_USERNAME/Projects/chatgpt-agent
MCP_ALLOWED_PATHS=/Users/REPLACE_WITH_YOUR_USERNAME/Projects/chatgpt-agent
MCP_MACOS_SANDBOX=true
MCP_MACOS_SANDBOX_HOME_ACCESS=isolated
MCP_DEFAULT_SHELL=/bin/zsh

# Operational limits
MCP_MAX_REQUEST_BODY=8mb
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_PROCESS_RETENTION_MS=3600000
MCP_MAX_PROCESSES=64
MCP_MAX_FILE_CHUNK_BYTES=1048576
MCP_MAX_EDIT_FILE_BYTES=67108864
